  <Target Name="CopiarArquivosDeApoio" AfterTargets="Build">
    <!-- Os scripts Python sao lidos em tempo de execucao via CaminhoApp(), ou seja,
         a partir da pasta do executavel. Sem esta copia eles so chegavam la pelo
         sincronizar.bat (que copia da pasta Downloads, nao do codigo-fonte): quem
         clonasse o repositorio e compilasse tinha TODA funcao de IA falhando com
         "python: can't open file", e a geracao do instalador abortava por falta
         dos .py na pasta Release. -->
    <ItemGroup>
      <ArquivosDeApoio Include="$(ProjectDir)*.py" />
      <ArquivosDeApoio Include="$(ProjectDir)icon2.ico" />
      <ArquivosDeApoio Include="$(ProjectDir)T2M_logo-03.png" />
      <ArquivosDeApoio Include="$(ProjectDir)..\requirements.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(ArquivosDeApoio)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>
